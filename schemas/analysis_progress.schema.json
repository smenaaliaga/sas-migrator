{
  "$defs": {
    "NodeReview": {
      "description": "Estado de revisión de un nodo en el ledger nodo-por-nodo de Fase 2.",
      "properties": {
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "batch": {
          "default": "",
          "title": "Batch",
          "type": "string"
        },
        "status": {
          "default": "pending",
          "title": "Status",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        }
      },
      "required": [
        "node_id"
      ],
      "title": "NodeReview",
      "type": "object"
    }
  },
  "description": "Ledger de cobertura del análisis LLM — ``state/analysis_progress.json``.\n\nGarantiza en disco lo que el contexto del agente no puede: que CADA nodo\nfue leído por code-analyst. El gate 2 exige cero ``pending``.",
  "properties": {
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "total_nodes": {
      "default": 0,
      "title": "Total Nodes",
      "type": "integer"
    },
    "reviewed": {
      "default": 0,
      "title": "Reviewed",
      "type": "integer"
    },
    "pending": {
      "default": 0,
      "title": "Pending",
      "type": "integer"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/NodeReview"
      },
      "title": "Nodes",
      "type": "array"
    }
  },
  "title": "AnalysisProgress",
  "type": "object"
}
