{
  "$defs": {
    "Answer": {
      "description": "User's answer to a question.",
      "properties": {
        "question_id": {
          "title": "Question Id",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "answered_at": {
          "format": "date-time",
          "title": "Answered At",
          "type": "string"
        }
      },
      "required": [
        "question_id",
        "value"
      ],
      "title": "Answer",
      "type": "object"
    },
    "Question": {
      "description": "A single interview question.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "question_type": {
          "$ref": "#/$defs/QuestionType",
          "default": "free_text"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        },
        "source_finding": {
          "default": "",
          "title": "Source Finding",
          "type": "string"
        },
        "context": {
          "default": "",
          "title": "Context",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "Question",
      "type": "object"
    },
    "QuestionType": {
      "enum": [
        "free_text",
        "single_choice",
        "multi_choice",
        "yes_no",
        "approval"
      ],
      "title": "QuestionType",
      "type": "string"
    }
  },
  "description": "A thematic group of questions within an interview.",
  "properties": {
    "block_id": {
      "title": "Block Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/Question"
      },
      "title": "Questions",
      "type": "array"
    },
    "answers": {
      "items": {
        "$ref": "#/$defs/Answer"
      },
      "title": "Answers",
      "type": "array"
    }
  },
  "required": [
    "block_id",
    "title"
  ],
  "title": "QuestionBlock",
  "type": "object"
}
