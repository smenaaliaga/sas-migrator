{
  "$defs": {
    "PlacementResolution": {
      "description": "Placement final de un nodo que el clasificador dejó ambiguous/hybrid,\ndecidido (o confirmado) por el usuario en el bloque B4b.",
      "properties": {
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "placement": {
          "title": "Placement",
          "type": "string"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "placement"
      ],
      "title": "PlacementResolution",
      "type": "object"
    }
  },
  "description": "Artefacto ``state/placement_decisions.yaml`` — lo escribe código tras\nB4b; el traductor (Etapa 4) lo consume como override del clasificador.",
  "properties": {
    "decisions": {
      "items": {
        "$ref": "#/$defs/PlacementResolution"
      },
      "title": "Decisions",
      "type": "array"
    },
    "confirmed_prefixes": {
      "items": {
        "type": "string"
      },
      "title": "Confirmed Prefixes",
      "type": "array"
    },
    "noise_prefixes": {
      "items": {
        "type": "string"
      },
      "title": "Noise Prefixes",
      "type": "array"
    }
  },
  "title": "PlacementDecisions",
  "type": "object"
}
