{
  "$defs": {
    "PreprocessType": {
      "enum": [
        "unpivot",
        "split",
        "lookup",
        "normalize",
        "recode",
        "scale",
        "bucket",
        "header_fix",
        "sheet_extract",
        "other"
      ],
      "title": "PreprocessType",
      "type": "string"
    }
  },
  "description": "A manual preprocessing step detected as candidate for automation.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "preprocess_type": {
      "$ref": "#/$defs/PreprocessType"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "file_path": {
      "title": "File Path",
      "type": "string"
    },
    "confirmed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confirmed"
    },
    "user_comment": {
      "default": "",
      "title": "User Comment",
      "type": "string"
    }
  },
  "required": [
    "id",
    "preprocess_type",
    "description",
    "file_path"
  ],
  "title": "PreprocessCandidate",
  "type": "object"
}
