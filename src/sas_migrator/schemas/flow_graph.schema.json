{
  "$defs": {
    "Edge": {
      "description": "A directed edge in the DAG.",
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "edge_type": {
          "default": "data_flow",
          "title": "Edge Type",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "Edge",
      "type": "object"
    },
    "NodeType": {
      "enum": [
        "DATA_STEP",
        "PROC_SQL",
        "PROC_SORT",
        "PROC_FREQ",
        "PROC_MEANS",
        "PROC_TRANSPOSE",
        "PROC_OTHER",
        "MACRO",
        "QUERY",
        "IMPORT",
        "EXPORT",
        "OTHER"
      ],
      "title": "NodeType",
      "type": "string"
    },
    "SASNode": {
      "description": "A single node in the SAS EG process flow.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "node_type": {
          "$ref": "#/$defs/NodeType",
          "default": "OTHER"
        },
        "code": {
          "default": "",
          "title": "Code",
          "type": "string"
        },
        "pfd_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pfd Id"
        },
        "pfd_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pfd Label"
        },
        "inputs": {
          "items": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "outputs": {
          "items": {
            "type": "string"
          },
          "title": "Outputs",
          "type": "array"
        },
        "libraries": {
          "items": {
            "type": "string"
          },
          "title": "Libraries",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id"
      ],
      "title": "SASNode",
      "type": "object"
    }
  },
  "description": "Complete DAG of a SAS EG project.",
  "properties": {
    "project_name": {
      "default": "",
      "title": "Project Name",
      "type": "string"
    },
    "egp_path": {
      "default": "",
      "title": "Egp Path",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/SASNode"
      },
      "title": "Nodes",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/Edge"
      },
      "title": "Edges",
      "type": "array"
    },
    "pfds": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Pfds",
      "type": "object"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    }
  },
  "title": "FlowGraph",
  "type": "object"
}
