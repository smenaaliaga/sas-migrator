{
  "$defs": {
    "CardProgress": {
      "description": "Posición de la tarjeta dentro de su bloque (para 'tarjeta 2 de 5').",
      "properties": {
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "total": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total"
        }
      },
      "required": [
        "index"
      ],
      "title": "CardProgress",
      "type": "object"
    },
    "Question": {
      "description": "A single interview question.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "question_type": {
          "$ref": "#/$defs/QuestionType",
          "default": "free_text"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        },
        "source_finding": {
          "default": "",
          "title": "Source Finding",
          "type": "string"
        },
        "context": {
          "default": "",
          "title": "Context",
          "type": "string"
        },
        "recommended_default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recommended Default"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "Question",
      "type": "object"
    },
    "QuestionType": {
      "enum": [
        "free_text",
        "single_choice",
        "multi_choice",
        "yes_no",
        "approval"
      ],
      "title": "QuestionType",
      "type": "string"
    }
  },
  "description": "Payload tipado de UNA llamada a ``interrupt()``.\n\nEs la unidad de conversación del UX lean: 1..n preguntas presentadas\njuntas, con default recomendado y evidencia por pregunta. Sin timestamps\npor diseño: el replay del nodo debe producir bytes idénticos.",
  "properties": {
    "card_id": {
      "title": "Card Id",
      "type": "string"
    },
    "interview_type": {
      "title": "Interview Type",
      "type": "string"
    },
    "phase": {
      "title": "Phase",
      "type": "integer"
    },
    "block_id": {
      "title": "Block Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "transition": {
      "default": "",
      "title": "Transition",
      "type": "string"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/Question"
      },
      "title": "Questions",
      "type": "array"
    },
    "allow_free_text": {
      "default": true,
      "title": "Allow Free Text",
      "type": "boolean"
    },
    "validation_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Validation Error"
    },
    "progress": {
      "anyOf": [
        {
          "$ref": "#/$defs/CardProgress"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "card_id",
    "interview_type",
    "phase",
    "block_id",
    "title"
  ],
  "title": "InterviewCard",
  "type": "object"
}
