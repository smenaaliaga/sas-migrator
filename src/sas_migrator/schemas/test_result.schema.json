{
  "$defs": {
    "TestStatus": {
      "enum": [
        "passed",
        "failed",
        "skipped",
        "error"
      ],
      "title": "TestStatus",
      "type": "string"
    },
    "TestType": {
      "enum": [
        "schema",
        "row_count",
        "aggregates",
        "row_by_row"
      ],
      "title": "TestType",
      "type": "string"
    }
  },
  "description": "Result of a single validation test.",
  "properties": {
    "test_type": {
      "$ref": "#/$defs/TestType"
    },
    "status": {
      "$ref": "#/$defs/TestStatus"
    },
    "dataset": {
      "default": "",
      "title": "Dataset",
      "type": "string"
    },
    "details": {
      "default": "",
      "title": "Details",
      "type": "string"
    },
    "expected": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected"
    },
    "actual": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actual"
    },
    "tolerance_used": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tolerance Used"
    }
  },
  "required": [
    "test_type",
    "status"
  ],
  "title": "TestResult",
  "type": "object"
}
