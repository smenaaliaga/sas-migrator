# Credenciales del migrador — copiar como .env (ignorado por git) y completar.
# Solo hace falta el bloque del proveedor que uses; el otro puede quedar vacío.
#
# Precedencia: entorno del proceso > <workspace>/.env > este .env (raíz del repo).
# Qué proveedor se usa lo decide project_config.yaml → llm.provider.

# ── provider: anthropic (API directa) ─────────────────────────────────────
ANTHROPIC_API_KEY=

# ── provider: foundry (Claude en Microsoft / Azure AI Foundry) ────────────
# Portal de Azure → recurso de AI Foundry → "Keys and Endpoint".
ANTHROPIC_FOUNDRY_API_KEY=
# El <resource> de https://<resource>.services.ai.azure.com
# Alternativa: llm.foundry_resource en project_config.yaml (no es secreto).
ANTHROPIC_FOUNDRY_RESOURCE=
